/* ---------------- PREEMPTIVE SJF ---------------- */

void preemptiveSJF(struct Process p[], int n)
{
    int time = 0;
    int completed = 0;

    int order[n * 20];
    int start[n * 20];
    int end[n * 20];
    int count = 0;

    while (completed < n)
    {
        int index = -1;
        int shortest = 9999;

        for (int i = 0; i < n; i++)
        {
            if (p[i].arrival <= time &&
                p[i].remaining > 0 &&
                p[i].remaining < shortest)
            {
                shortest = p[i].remaining;
                index = i;
            }
        }

        if (index == -1)
        {
            time++;
            continue;
        }

        start[count] = time;
        order[count] = index;

        p[index].remaining--;
        time++;

        end[count] = time;

        if (p[index].remaining == 0)
        {
            p[index].completion = time;
            completed++;
        }

        count++;
    }

    printGantt(p, order, start, end, count);
    printResults(p, n);
}

