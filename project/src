/* ---------------- ROUND ROBIN ---------------- */

void roundRobin(struct Process p[], int n, int quantum)
{
    int time = 0;
    int completed = 0;

    int order[n * 20];
    int start[n * 20];
    int end[n * 20];
    int count = 0;

    while (completed < n)
    {
        int found = 0;

        for (int i = 0; i < n; i++)
        {
            if (p[i].remaining > 0 &&
                p[i].arrival <= time)
            {
                found = 1;

                start[count] = time;
                order[count] = i;

                if (p[i].remaining > quantum)
                {
                    time = time + quantum;
                    p[i].remaining = p[i].remaining - quantum;
                }
                else
                {
                    time = time + p[i].remaining;
                    p[i].remaining = 0;
                    p[i].completion = time;
                    completed++;
                }

                end[count] = time;
                count++;
            }
        }

        if (found == 0)
        {
            time++;
        }
    }

    printGantt(p, order, start, end, count);
    printResults(p, n);
}

/* ---------------- MAIN ---------------- */

int main()
{
    int n;
    int approach;
    int choice;
    int quantum;

    printf("========================================\n");
    printf("       CPU SCHEDULING SIMULATOR\n");
    printf("========================================\n");

    printf("\nEnter number of processes: ");
    scanf("%d", &n);

    struct Process *p = malloc(n * sizeof(struct Process));

    for (int i = 0; i < n; i++)
    {
        p[i].pid = i + 1;
        p[i].completion = 0;

        printf("\n---------- Process %d ----------\n", i + 1);

        printf("Arrival Time : ");
        scanf("%d", &p[i].arrival);

        printf("Burst Time   : ");
        scanf("%d", &p[i].burst);

        printf("Priority     : ");
        scanf("%d", &p[i].priority);

        p[i].remaining = p[i].burst;
    }

    printf("\n\nProcess Details\n");
    printf("-------------------------------------------------\n");
    printf("PID\tArrival\tBurst\tPriority\n");
    printf("-------------------------------------------------\n");

    for (int i = 0; i < n; i++)
    {
        printf("P%d\t%d\t%d\t%d\n",
               p[i].pid,
               p[i].arrival,
               p[i].burst,
               p[i].priority);
    }

    /* FIRST CHOOSE APPROACH */

    printf("\n\nChoose Scheduling Approach\n");
    printf("==========================\n");
    printf("1. Non-Preemptive\n");
    printf("2. Preemptive\n");

    printf("\nEnter choice: ");
    scanf("%d", &approach);

    /* NON-PREEMPTIVE */

    if (approach == 1)
    {
        printf("\n\nNon-Preemptive Algorithms\n");
        printf("=========================\n");
        printf("1. FCFS\n");
        printf("2. SJF\n");
        printf("3. Priority\n");

        printf("\nEnter algorithm: ");
        scanf("%d", &choice);

        if (choice == 1)
        {
            printf("\nSelected: FCFS");
            printf("\nApproach: Non-Preemptive\n");

            fcfs(p, n);
        }
        else if (choice == 2)
        {
            printf("\nSelected: SJF");
            printf("\nApproach: Non-Preemptive\n");

            sjf(p, n);
        }
        else if (choice == 3)
        {
            printf("\nSelected: Priority");
            printf("\nApproach: Non-Preemptive\n");

            priorityNonPreemptive(p, n);
        }
        else
        {
            printf("\nInvalid algorithm choice\n");
        }
    }

    /* PREEMPTIVE */

    else if (approach == 2)
    {
        printf("\n\nPreemptive Algorithms\n");
        printf("====================\n");
        printf("1. SJF (SRTF)\n");
        printf("2. Priority\n");
        printf("3. Round Robin\n");

        printf("\nEnter algorithm: ");
        scanf("%d", &choice);

        if (choice == 1)
        {
            printf("\nSelected: SJF");
            printf("\nApproach: Preemptive\n");

            preemptiveSJF(p, n);
        }
        else if (choice == 2)
        {
            printf("\nSelected: Priority");
            printf("\nApproach: Preemptive\n");

            preemptivePriority(p, n);
        }
        else if (choice == 3)
        {
            printf("\nSelected: Round Robin");
            printf("\nApproach: Preemptive\n");

            printf("\nEnter Time Quantum: ");
            scanf("%d", &quantum);

            roundRobin(p, n, quantum);
        }
        else
        {
            printf("\nInvalid algorithm choice\n");
        }
    }

    else
    {
        printf("\nInvalid approach choice\n");
    }

    free(p);

    return 0;
}


