#include <stdio.h>
#include <stdlib.h>

struct Process
{
    int pid;
    int arrival;
    int burst;
    int priority;
    int remaining;
    int completion;
};

void printResults(struct Process p[], int n)
{
    float avgWT = 0;
    float avgTAT = 0;

    printf("\n\nScheduling Results\n");
    printf("-------------------------------------------------\n");
    printf("PID\tAT\tBT\tPriority\tCT\tTAT\tWT\n");
    printf("-------------------------------------------------\n");

    for (int i = 0; i < n; i++)
    {
        int turnaround = p[i].completion - p[i].arrival;
        int waiting = turnaround - p[i].burst;

        printf("P%d\t%d\t%d\t%d\t\t%d\t%d\t%d\n",
               p[i].pid,
               p[i].arrival,
               p[i].burst,
               p[i].priority,
               p[i].completion,
               turnaround,
               waiting);

        avgWT = avgWT + waiting;
        avgTAT = avgTAT + turnaround;
    }

    printf("-------------------------------------------------\n");
    printf("Average Waiting Time    = %.2f\n", avgWT / n);
    printf("Average Turnaround Time = %.2f\n", avgTAT / n);
}

void printGantt(struct Process p[], int order[], int start[],
                int end[], int count)
{
    printf("\n\n");
    printf("              CPU GANTT CHART\n");
    printf("        ");

    for (int i = 0; i < count; i++)
    {
        printf("----------");
    }

    printf("-\n");

    printf("        ");

    for (int i = 0; i < count; i++)
    {
        printf("|   P%d   ", p[order[i]].pid);
    }

    printf("|\n");

    printf("        ");

    for (int i = 0; i < count; i++)
    {
        printf("----------");
    }

    printf("-\n");

    printf("        %d", start[0]);

    for (int i = 0; i < count; i++)
    {
        printf("        %d", end[i]);
    }

    printf("\n");
}

/* ---------------- NON-PREEMPTIVE FCFS ---------------- */

void fcfs(struct Process p[], int n)
{
    int time = 0;
    int order[n];
    int start[n];
    int end[n];
    int count = 0;

    for (int i = 0; i < n; i++)
    {
        if (time < p[i].arrival)
        {
            time = p[i].arrival;
        }

        start[count] = time;
        order[count] = i;

        time = time + p[i].burst;

        end[count] = time;
        p[i].completion = time;

        count++;
    }

    printGantt(p, order, start, end, count);
    printResults(p, n);
}

/* ---------------- NON-PREEMPTIVE SJF ---------------- */

void sjf(struct Process p[], int n)
{
    int time = 0;
    int completed = 0;

    int order[n];
    int start[n];
    int end[n];
    int count = 0;

    while (completed < n)
    {
        int index = -1;
        int shortest = 9999;

        for (int i = 0; i < n; i++)
        {
            if (p[i].completion == 0 &&
                p[i].arrival <= time &&
                p[i].burst < shortest)
            {
                shortest = p[i].burst;
                index = i;
            }
        }

        if (index == -1)
        {
            time++;
            continue;
        }

        start[count] = time;
        order[count] = index;

        time = time + p[index].burst;

        end[count] = time;
        p[index].completion = time;

        completed++;
        count++;
    }

    printGantt(p, order, start, end, count);
    printResults(p, n);
}

